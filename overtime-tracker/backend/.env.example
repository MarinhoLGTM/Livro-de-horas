# String de conexão do Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Senha única para entrar na app (defina algo só seu)
APP_PASSWORD=troque_isto

# Segredo usado para assinar o token de login (qualquer texto longo e aleatório)
JWT_SECRET=troque_isto_tambem_por_algo_bem_aleatorio

# Porta do servidor (Render define isso automaticamente em produção)
PORT=3000
